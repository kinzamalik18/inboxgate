# "gemini" for real use, "fake" for offline tests and keyless demos.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model names change. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inboxgate

# Shared secret between n8n and this API. Use a long random string, and set the
# same value as INBOXGATE_TOKEN in n8n.
WORKFLOW_TOKEN=

# n8n webhook for new emails, for example https://your-n8n/webhook/inboxgate-inbound
# Leave empty to run without n8n.
N8N_INBOUND_URL=

# Optional. When set, the review screens ask for this password (user name: reviewer).
REVIEW_PASSWORD=

AUTO_ARCHIVE_CONFIDENCE=0.85
